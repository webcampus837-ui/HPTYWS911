# HBTYWS911 — environment variables
#
# Copy this file to `.env` and fill in the values from your Supabase project.
#   Supabase Dashboard → Project Settings → API
#
# NEVER put the service_role / secret key here — it must never reach the browser.
# Only the public anon (publishable) key belongs in frontend code.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
